set -euo pipefail
ECAD_HOOK_ROOT="$(git rev-parse --show-toplevel)"
while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "$local_oid" =~ ^0+$ ]]; then continue; fi
  python3 "$ECAD_HOOK_ROOT/scripts/check_publication.py" --history --revision "$local_oid"
done
